# PartyKit host for local development
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999

# Cloud-prem PartyKit deploy (your own Cloudflare account)
# Get these from https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Your Cloudflare workers.dev subdomain, e.g. bekind-party.parkthomp.workers.dev
# Find your workers.dev subdomain in Cloudflare Dashboard > Workers & Pages
PARTYKIT_DOMAIN=
